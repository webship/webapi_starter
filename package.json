{
  "name": "webapi_starter",
  "private": true,
  "description": "WebAPI Starter: the basic Drupal API site template, a documented and read-only JSON:API.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "packageManager": "yarn@4.18.1",
  "keywords": [
    "Drupal",
    "Recipe",
    "JSON:API",
    "OpenAPI"
  ],
  "author": "Webship.co",
  "scripts": {
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:dry": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js --dry-run"
  },
  "devDependencies": {
    "@webship-js/drupal-core-steps": "^2.1.0",
    "webship-js": "^2.0.6"
  },
  "resolutions": {
    "@cucumber/cucumber": "10.0.1"
  }
}
